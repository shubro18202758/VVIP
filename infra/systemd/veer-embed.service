# Veer memory tier — embedding-service (pplx-embed-v2-late-0.6b + bge-m3) on
# 127.0.0.1:8085. Waits for the corridor-store port (127.0.0.1:$POSTGIS_HOST_PORT)
# before starting: user units cannot order After=docker.service.
# Pulled in by veer-models.target; installed (linked) by
# scripts/veer_up.sh --install-units. Paths come from ~/.config/veer/veer.env.
[Unit]
Description=Veer memory tier: embedding-service on 127.0.0.1:8085
PartOf=veer-models.target
StartLimitIntervalSec=0

[Service]
Type=simple
# a linger boot has no login session: pin the PATH the hand-launched hosts
# ran with (CUDA tools for torch/llama.cpp; libraries resolve via ld.so.conf)
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/veer/veer.env
ExecStart=/bin/bash ${VEER_ROOT}/infra/scripts/serve_models.sh --foreground embed
Restart=always
RestartSec=5
# 78 = EX_CONFIG: app, venv or launcher missing — report once, don't spin
RestartPreventExitStatus=78
TimeoutStopSec=30
# Shared GB10 unified pool: a model host must be the kernel's preferred OOM
# victim (host convention, nemotron memguard notes), never the desktop session.
OOMScoreAdjust=500
