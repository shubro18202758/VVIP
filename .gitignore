# ONNX model binaries (large files)
*.onnx

# Clone-local model experiments (downloaded artifacts + their NOTICEs;
# the sanctioned home per the models-local policy — never committed)
models-local/

# Repetition-gate run workdirs — scripts/repetition_gate.sh mkdir -p's
# WORKROOT="$VVIP_DIR/showcase/repetition" and every run drops a
# <timestamp>Z-r<rounds>-<pid>/ dir (baseline.json, container snapshots,
# round projections). Machine output, never a deliverable.
showcase/repetition/

# Test-run artifacts (screens-verify manifest + PNG shots under
# tests/artifacts/screens/; anything a future gate writes there) —
# regenerated per run, never committed.
tests/artifacts/

# Vite cache
.vite/

# Bun
bun.lockb

# Host-shared model home — a symlink into this host's original-stack models
# dir (machine glue like .venvs; the configs previously tracked under
# models/ moved there 2026-10-13, recorded as deletions). Never committed.
/models
.mimosa/
.run-models/
